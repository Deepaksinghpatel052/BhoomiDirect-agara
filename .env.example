# Copy to .env and edit:  cp .env.example .env
# ---------------------------------------------------------------
# REQUIRED on a server
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
# * = site opens on ANY domain or IP (no "Bad Request (400)" when the IP/domain changes).
# To lock it down later, list them instead: 182.64.233.217,your-domain.com
DJANGO_ALLOWED_HOSTS=*
# Optional. Forms already work on any domain/IP; only needed behind an extra HTTPS proxy
# (e.g. Cloudflare) - then list full origins: https://your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Used for canonical URLs, sitemap.xml and social share links
SITE_DOMAIN=https://your-domain.com

# ---------------------------------------------------------------
# Demo data: load sample data automatically on the FIRST start only
SEED_DEMO_ON_START=true
# Change the demo admin password (admin / admin123) on start
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_PASSWORD=

# ---------------------------------------------------------------
# HTTPS (turn on only after HTTPS works in front of the app)
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_COOKIES=false
DJANGO_HSTS_SECONDS=0

# ---------------------------------------------------------------
# Port & stack name (read by docker compose)
# The site opens on http://<server>:HTTP_PORT  (80 = no port in the URL)
HTTP_PORT=80
# 0.0.0.0 = reachable from outside; 127.0.0.1 = only via a host reverse proxy (HTTPS option B)
HTTP_BIND=0.0.0.0
# Unique name per copy: lets you run several copies on different ports
COMPOSE_PROJECT_NAME=bhoomidirect

# ---------------------------------------------------------------
# Server tuning
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
DJANGO_LOG_LEVEL=INFO
# Nginx serves /media/ in docker-compose; Django serves it if you run only the web container
DJANGO_SERVE_MEDIA=true
